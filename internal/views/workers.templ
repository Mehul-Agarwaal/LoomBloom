package views

import (
	"fmt"
	"loombloom/internal/store"
)

templ WorkersPage(org store.Organization, workers []store.Worker, errStr string) {
	@PageLayout("Workers", org, "workers") {
		<div class="page-header">
			<div class="page-title">
				<h2>Workers</h2>
				<p>Manage staff, shifts, and track performance.</p>
			</div>
			<a href="/workers/new" class="btn btn-primary">Add Worker</a>
		</div>

		if errStr != "" {
			<div class="alert alert-danger">
				<strong>Error:</strong> { errStr }
			</div>
		}

		<div class="section">
			<header>
				<h3>Staff Directory</h3>
				<span class="subtle">{ fmt.Sprintf("%d total", len(workers)) }</span>
			</header>
			if len(workers) == 0 {
				<p class="empty">No workers added yet. Click "Add Worker" to get started.</p>
			} else {
				<table>
					<thead>
						<tr>
							<th>Name</th>
							<th>Contact</th>
							<th>Shifts</th>
							<th>Avg Production</th>
							<th>Action</th>
						</tr>
					</thead>
					<tbody>
						for _, w := range workers {
							<tr>
								<td style="font-weight: 600;">{ w.Name }</td>
								<td>{ w.Phone }</td>
								<td>{ fmt.Sprintf("%d", w.NumberOfShifts) }</td>
								<td>{ fmt.Sprintf("%.2f meters", w.AverageProduction) }</td>
								<td>
									<a href={ templ.URL(fmt.Sprintf("/workers/%s", w.ID)) } style="color: var(--neon-blue); text-decoration: none; font-size: 13px;">Profile</a>
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
		</div>
	}
}

templ WorkerFormPage(org store.Organization, errStr string) {
	@PageLayout("Add Worker", org, "workers") {
		<div class="page-header">
			<div class="page-title">
				<h2>Add New Worker</h2>
				<p>Register staff members and assign shifts.</p>
			</div>
			<a href="/workers" class="btn" style="border: 1px solid var(--line); color: var(--ink);">Back to Directory</a>
		</div>

		if errStr != "" {
			<div class="alert alert-danger">
				<strong>Error:</strong> { errStr }
			</div>
		}

		<div style="max-width: 600px; margin: 0 auto;">
			<div class="form-card" style="position: static;">
				<h3>Worker Details</h3>
				<form action="/workers" method="POST">
					<div class="form-group">
						<label for="name">Full Name *</label>
						<input type="text" id="name" name="name" class="form-control" placeholder="e.g. Ramesh Kumar" required />
					</div>
					<div class="form-group">
						<label for="phone">Phone Number</label>
						<input type="text" id="phone" name="phone" class="form-control" placeholder="e.g. +91 98765 43210" />
					</div>
					<div class="form-row">
						<div class="form-group">
							<label for="average_production">Avg Production Target</label>
							<input type="number" step="0.01" id="average_production" name="average_production" class="form-control" placeholder="e.g. 150.5" />
						</div>
						<div class="form-group">
							<label for="close_per_shift">Target Closes / Shift</label>
							<input type="number" id="close_per_shift" name="close_per_shift" class="form-control" placeholder="e.g. 2" />
						</div>
					</div>
					<div class="form-group">
						<label for="number_of_shifts">Shifts Assigned</label>
						<input type="number" id="number_of_shifts" name="number_of_shifts" class="form-control" value="1" min="1" max="3" />
					</div>
					<button type="submit" class="btn btn-primary btn-block" style="margin-top: 16px;">Add Worker</button>
				</form>
			</div>
		</div>
	}
}

templ WorkerDetailPage(org store.Organization, worker store.Worker) {
	@PageLayout(fmt.Sprintf("Worker %s", worker.Name), org, "workers") {
		<div class="page-header">
			<div class="page-title">
				<h2>{ worker.Name }</h2>
				<p>Profile and performance stats.</p>
			</div>
			<a href="/workers" class="btn" style="border: 1px solid var(--line); color: var(--ink);">Back to Directory</a>
		</div>

		<div class="section" style="margin-bottom: 24px; padding: 24px;">
			<div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px;">
				<div>
					<p class="subtle">Contact</p>
					<p style="font-size: 16px; font-weight: 600; margin-top: 4px;">{ worker.Phone }</p>
				</div>
				<div>
					<p class="subtle">Shifts</p>
					<p style="font-size: 18px; font-weight: 600; margin-top: 4px;">{ fmt.Sprintf("%d", worker.NumberOfShifts) }</p>
				</div>
				<div>
					<p class="subtle">Avg Production Target</p>
					<p style="font-size: 18px; font-weight: 600; margin-top: 4px; color: var(--ok);">{ fmt.Sprintf("%.2f", worker.AverageProduction) }</p>
				</div>
				<div>
					<p class="subtle">Joined</p>
					<p style="font-size: 18px; font-weight: 600; margin-top: 4px;">{ worker.CreatedAt.Format("Jan 02, 2006") }</p>
				</div>
			</div>
		</div>

		<div class="section">
			<header>
				<h3>Recent Shifts (Mock)</h3>
			</header>
			<p class="empty">Production entries for this worker will appear here.</p>
		</div>
	}
}
