package views

import (
	"fmt"
	"loombloom/internal/store"
)

templ StockPage(org store.Organization, stock []store.StockItem, errStr string) {
	@PageLayout("Stock", org, "stock") {
		<div class="page-header">
			<div class="page-title">
				<h2>Finished Stock ({ org.Name })</h2>
				<p>Track manufactured rolls, fabrics, and storage positions.</p>
			</div>
		</div>

		if errStr != "" {
			<div class="alert alert-danger">
				<strong>Error:</strong> { errStr }
			</div>
		}

		<div class="two-col">
			<div class="section">
				<header>
					<h3>Inventory Catalog</h3>
					<span class="subtle">{ fmt.Sprintf("%d items", len(stock)) }</span>
				</header>
				if len(stock) == 0 {
					<p class="empty">No stock registered. Use the panel on the right to log stock.</p>
				} else {
					<table>
						<thead>
							<tr>
								<th>Item Name</th>
								<th>Quality</th>
								<th>Location</th>
								<th>Quantity</th>
							</tr>
						</thead>
						<tbody>
							for _, s := range stock {
								<tr>
									<td style="font-weight: 600;">{ s.Name }</td>
									<td>{ s.Quality }</td>
									<td>{ s.StoredOn }</td>
									<td style="font-weight: 600; color: var(--accent);">{ fmt.Sprintf("%.2f %s", s.Quantity, s.Unit) }</td>
								</tr>
							}
						</tbody>
					</table>
				}
			</div>

			<div>
				<div class="form-card">
					<h3>Log Finished Stock</h3>
					<form action="/stock" method="POST">
						<div class="form-group">
							<label for="name">Item Name *</label>
							<input type="text" id="name" name="name" class="form-control" placeholder="e.g. Grey Cotton Fabric" required />
						</div>
						<div class="form-group">
							<label for="quality">Quality Grade</label>
							<input type="text" id="quality" name="quality" class="form-control" placeholder="e.g. Premium cotton, Semi-soft" />
						</div>
						<div class="form-group">
							<label for="stored_on">Storage Location</label>
							<input type="text" id="stored_on" name="stored_on" class="form-control" placeholder="e.g. Rack A1, Shelf C" />
						</div>
						<div class="form-row">
							<div class="form-group">
								<label for="quantity">Quantity *</label>
								<input type="number" step="0.01" id="quantity" name="quantity" class="form-control" placeholder="0.00" required />
							</div>
							<div class="form-group">
								<label for="unit">Unit</label>
								<input type="text" id="unit" name="unit" class="form-control" value="meters" />
							</div>
						</div>
						<button type="submit" class="btn btn-primary btn-block" style="margin-top: 8px;">Log Stock Item</button>
					</form>
				</div>
			</div>
		</div>
	}
}
