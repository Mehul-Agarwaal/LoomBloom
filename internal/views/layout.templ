package views

import (
	"loombloom/internal/store"
)

templ PageLayout(title string, org store.Organization, activeTab string) {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } - LoomBloom</title>
			<style>
				:root {
					color-scheme: light;
					--ink: #17202a;
					--muted: #5c6673;
					--line: #d9dee5;
					--paper: #f7f3ea;
					--panel: #ffffff;
					--accent: #0f766e;
					--accent-2: #b45309;
					--ok: #166534;
					--warn: #92400e;
					--danger: #b91c1c;
				}
				* { box-sizing: border-box; }
				body {
					margin: 0;
					font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
					color: var(--ink);
					background: var(--paper);
				}
				.shell { min-height: 100vh; display: flex; flex-direction: column; }
				.topbar {
					display: flex;
					align-items: center;
					justify-content: space-between;
					gap: 24px;
					padding: 18px 28px;
					border-bottom: 1px solid var(--line);
					background: rgba(255, 255, 255, 0.88);
					backdrop-filter: blur(8px);
					position: sticky;
					top: 0;
					z-index: 100;
				}
				.topbar-left {
					display: flex;
					align-items: center;
					gap: 32px;
					flex: 1;
				}
				.brand { display: flex; align-items: center; gap: 12px; min-width: 0; text-decoration: none; color: inherit; }
				.mark {
					display: grid;
					place-items: center;
					width: 40px;
					height: 40px;
					border-radius: 8px;
					background: var(--accent);
					color: white;
					font-weight: 800;
				}
				h1, h2, h3, p { margin: 0; }
				h1 { font-size: 18px; line-height: 1.2; }
				.subtle { color: var(--muted); font-size: 13px; margin-top: 3px; }
				.badge {
					display: inline-flex;
					align-items: center;
					height: 30px;
					padding: 0 10px;
					border: 1px solid var(--line);
					border-radius: 999px;
					background: var(--panel);
					color: var(--muted);
					font-size: 13px;
					white-space: nowrap;
					text-transform: capitalize;
				}
				.nav-tabs {
					display: flex;
					gap: 6px;
				}
				.nav-tabs a {
					text-decoration: none;
					color: var(--muted);
					font-size: 14px;
					font-weight: 500;
					padding: 8px 14px;
					border-radius: 6px;
					transition: all 0.2s ease;
				}
				.nav-tabs a:hover {
					color: var(--ink);
					background: rgba(0, 0, 0, 0.04);
				}
				.nav-tabs a.active {
					color: var(--accent);
					background: rgba(15, 118, 110, 0.1);
					font-weight: 600;
				}
				main { padding: 28px; max-width: 1280px; width: 100%; margin: 0 auto; flex: 1; }
				
				/* Typography & General helper classes */
				.page-header {
					display: flex;
					align-items: center;
					justify-content: space-between;
					gap: 20px;
					margin-bottom: 24px;
				}
				.page-title h2 { font-size: 30px; font-weight: 700; letter-spacing: -0.5px; }
				.page-title p { color: var(--muted); margin-top: 4px; }
				
				/* Forms */
				.form-card {
					background: var(--panel);
					border: 1px solid var(--line);
					border-radius: 12px;
					padding: 24px;
					position: sticky;
					top: 100px;
				}
				.form-card h3 {
					font-size: 16px;
					font-weight: 600;
					margin-bottom: 16px;
					border-bottom: 1px solid var(--line);
					padding-bottom: 12px;
				}
				.form-group {
					margin-bottom: 16px;
				}
				.form-group label {
					display: block;
					font-size: 13px;
					font-weight: 600;
					margin-bottom: 6px;
					color: var(--ink);
				}
				.form-control {
					width: 100%;
					height: 38px;
					padding: 8px 12px;
					border: 1px solid var(--line);
					border-radius: 6px;
					background: var(--panel);
					color: var(--ink);
					font-family: inherit;
					font-size: 14px;
					transition: border-color 0.15s ease;
				}
				.form-control:focus {
					outline: none;
					border-color: var(--accent);
				}
				.form-row {
					display: grid;
					grid-template-columns: repeat(2, minmax(0, 1fr));
					gap: 12px;
				}
				.btn {
					display: inline-flex;
					align-items: center;
					justify-content: center;
					height: 38px;
					padding: 0 16px;
					border-radius: 6px;
					font-size: 14px;
					font-weight: 600;
					border: 1px solid transparent;
					cursor: pointer;
					transition: all 0.15s ease;
					font-family: inherit;
				}
				.btn-primary {
					background: var(--accent);
					color: white;
				}
				.btn-primary:hover {
					background: #0d645d;
				}
				.btn-block {
					display: flex;
					width: 100%;
				}
				
				/* Grid & Layout */
				.two-col {
					display: grid;
					grid-template-columns: minmax(0, 2fr) minmax(320px, 1fr);
					gap: 24px;
				}
				.hero-panel, .section {
					background: var(--panel);
					border: 1px solid var(--line);
					border-radius: 8px;
				}
				.section { overflow: hidden; }
				.section header {
					display: flex;
					justify-content: space-between;
					align-items: center;
					gap: 16px;
					padding: 16px 18px;
					border-bottom: 1px solid var(--line);
				}
				.section h3 { font-size: 16px; font-weight: 600; }
				
				/* Tables */
				table { width: 100%; border-collapse: collapse; table-layout: fixed; }
				th, td { padding: 13px 18px; text-align: left; border-bottom: 1px solid var(--line); font-size: 14px; vertical-align: middle; }
				th { color: var(--muted); font-weight: 600; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; }
				td { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
				tr:last-child td { border-bottom: 0; }
				.status {
					display: inline-flex;
					align-items: center;
					height: 24px;
					padding: 0 8px;
					border-radius: 999px;
					background: #ecfdf5;
					color: var(--ok);
					font-size: 12px;
					text-transform: capitalize;
				}
				.status.warn { background: #fffbeb; color: var(--warn); }
				.empty { padding: 36px 18px; color: var(--muted); text-align: center; font-size: 14px; }
				
				/* Alerts */
				.alert {
					padding: 12px 16px;
					border-radius: 6px;
					margin-bottom: 16px;
					font-size: 14px;
				}
				.alert-danger {
					background: #fef2f2;
					border: 1px solid #fee2e2;
					color: var(--danger);
				}
				
				@media (max-width: 920px) {
					.two-col { grid-template-columns: 1fr; }
					.topbar-left { gap: 16px; }
				}
				@media (max-width: 768px) {
					.topbar { align-items: flex-start; flex-direction: column; padding: 16px; }
					.topbar-left { flex-direction: column; align-items: flex-start; width: 100%; }
					.nav-tabs { width: 100%; overflow-x: auto; padding-bottom: 4px; }
					main { padding: 16px; }
				}
			</style>
		</head>
		<body>
			<div class="shell">
				<header class="topbar">
					<div class="topbar-left">
						<a href="/" class="brand">
							<div class="mark">LB</div>
							<div>
								<h1>LoomBloom</h1>
								<p class="subtle">Loom owner operations dashboard</p>
							</div>
						</a>
						<nav class="nav-tabs">
							<a href="/" class={ templ.KV("active", activeTab == "dashboard") }>Dashboard</a>
							<a href="/machines" class={ templ.KV("active", activeTab == "machines") }>Machines</a>
							<a href="/workers" class={ templ.KV("active", activeTab == "workers") }>Workers</a>
							<a href="/stock" class={ templ.KV("active", activeTab == "stock") }>Stock</a>
							<a href="/production" class={ templ.KV("active", activeTab == "production") }>Production</a>
						</nav>
					</div>
					if org.ID != "" {
						<div class="badge">{ org.SubscriptionPlan } plan</div>
					}
				</header>
				<main>
					{ children... }
				</main>
			</div>
		</body>
	</html>
}
