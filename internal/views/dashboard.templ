package views

import (
	"fmt"
	"loombloom/internal/store"
)

templ DashboardPage(data store.Dashboard) {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>LoomBloom</title>
			<style>
				:root {
					color-scheme: light;
					--ink: #17202a;
					--muted: #5c6673;
					--line: #d9dee5;
					--paper: #f7f3ea;
					--panel: #ffffff;
					--accent: #0f766e;
					--accent-2: #b45309;
					--ok: #166534;
					--warn: #92400e;
				}
				* { box-sizing: border-box; }
				body {
					margin: 0;
					font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
					color: var(--ink);
					background: var(--paper);
				}
				.shell { min-height: 100vh; }
				.topbar {
					display: flex;
					align-items: center;
					justify-content: space-between;
					gap: 24px;
					padding: 18px 28px;
					border-bottom: 1px solid var(--line);
					background: rgba(255, 255, 255, 0.88);
				}
				.brand { display: flex; align-items: center; gap: 12px; min-width: 0; }
				.mark {
					display: grid;
					place-items: center;
					width: 40px;
					height: 40px;
					border-radius: 8px;
					background: var(--accent);
					color: white;
					font-weight: 800;
				}
				h1, h2, h3, p { margin: 0; }
				h1 { font-size: 18px; line-height: 1.2; }
				.subtle { color: var(--muted); font-size: 13px; margin-top: 3px; }
				.badge {
					display: inline-flex;
					align-items: center;
					height: 30px;
					padding: 0 10px;
					border: 1px solid var(--line);
					border-radius: 999px;
					background: var(--panel);
					color: var(--muted);
					font-size: 13px;
					white-space: nowrap;
				}
				main { padding: 28px; max-width: 1280px; margin: 0 auto; }
				.hero {
					display: grid;
					grid-template-columns: minmax(0, 1.7fr) minmax(260px, 0.8fr);
					gap: 22px;
					align-items: stretch;
					margin-bottom: 22px;
				}
				.hero-panel, .side-panel, .section {
					background: var(--panel);
					border: 1px solid var(--line);
					border-radius: 8px;
				}
				.hero-panel { padding: 24px; }
				.hero-panel h2 { font-size: clamp(28px, 4vw, 48px); line-height: 1.02; max-width: 780px; letter-spacing: 0; }
				.hero-panel p { margin-top: 12px; max-width: 720px; color: var(--muted); line-height: 1.6; }
				.side-panel { padding: 18px; display: grid; align-content: space-between; gap: 18px; }
				.side-panel strong { display: block; font-size: 30px; }
				.grid {
					display: grid;
					grid-template-columns: repeat(4, minmax(0, 1fr));
					gap: 14px;
					margin-bottom: 22px;
				}
				.metric {
					min-height: 118px;
					padding: 16px;
					border: 1px solid var(--line);
					border-radius: 8px;
					background: var(--panel);
				}
				.metric span { color: var(--muted); font-size: 13px; }
				.metric strong { display: block; margin-top: 12px; font-size: 28px; line-height: 1.1; }
				.metric em { display: block; margin-top: 8px; color: var(--accent); font-size: 12px; font-style: normal; }
				.columns {
					display: grid;
					grid-template-columns: repeat(2, minmax(0, 1fr));
					gap: 18px;
				}
				.section { overflow: hidden; }
				.section header {
					display: flex;
					justify-content: space-between;
					gap: 16px;
					padding: 16px 18px;
					border-bottom: 1px solid var(--line);
				}
				.section h3 { font-size: 16px; }
				table { width: 100%; border-collapse: collapse; table-layout: fixed; }
				th, td { padding: 13px 18px; text-align: left; border-bottom: 1px solid var(--line); font-size: 14px; vertical-align: middle; }
				th { color: var(--muted); font-weight: 600; font-size: 12px; }
				td { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
				tr:last-child td { border-bottom: 0; }
				.status {
					display: inline-flex;
					align-items: center;
					height: 24px;
					padding: 0 8px;
					border-radius: 999px;
					background: #ecfdf5;
					color: var(--ok);
					font-size: 12px;
				}
				.status.warn { background: #fffbeb; color: var(--warn); }
				.empty { padding: 24px 18px; color: var(--muted); }
				@media (max-width: 920px) {
					.hero, .columns { grid-template-columns: 1fr; }
					.grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
				}
				@media (max-width: 620px) {
					.topbar { align-items: flex-start; flex-direction: column; padding: 16px; }
					main { padding: 16px; }
					.grid { grid-template-columns: 1fr; }
					th, td { padding: 12px; }
				}
			</style>
		</head>
		<body>
			<div class="shell">
				<header class="topbar">
					<div class="brand">
						<div class="mark">LB</div>
						<div>
							<h1>LoomBloom</h1>
							<p class="subtle">Loom owner operations dashboard</p>
						</div>
					</div>
					if data.Organization.ID != "" {
						<div class="badge">{ data.Organization.SubscriptionPlan } plan</div>
					}
				</header>
				<main>
					if data.Organization.ID == "" {
						<section class="hero-panel">
							<h2>No business data yet</h2>
							<p>Run the development seed migration to populate machines, workers, stock, raw materials, payments, and production records.</p>
						</section>
					} else {
						<section class="hero">
							<div class="hero-panel">
								<h2>{ data.Organization.Name }</h2>
								<p>Track machines, workers, inventory, production, and payments from one practical workspace built for daily loom business management.</p>
							</div>
							<aside class="side-panel">
								<div>
									<p class="subtle">Owner</p>
									<strong>{ data.Organization.OwnerName }</strong>
								</div>
								<div>
									<p class="subtle">Phone</p>
									<strong>{ data.Organization.Phone }</strong>
								</div>
							</aside>
						</section>
						<section class="grid">
							<div class="metric"><span>Machines</span><strong>{ fmt.Sprint(data.MachineCount) }</strong><em>registered looms</em></div>
							<div class="metric"><span>Workers</span><strong>{ fmt.Sprint(data.WorkerCount) }</strong><em>active staff records</em></div>
							<div class="metric"><span>Today Production</span><strong>{ fmt.Sprintf("%.2f m", data.TodayProduction) }</strong><em>current day output</em></div>
							<div class="metric"><span>Stock Quantity</span><strong>{ fmt.Sprintf("%.2f", data.StockQuantity) }</strong><em>finished and stored stock</em></div>
							<div class="metric"><span>Raw Materials</span><strong>{ fmt.Sprint(data.RawMaterialCount) }</strong><em>material categories</em></div>
							<div class="metric"><span>Spare Parts</span><strong>{ fmt.Sprint(data.SparePartCount) }</strong><em>maintenance inventory</em></div>
							<div class="metric"><span>Payments</span><strong>{ fmt.Sprintf("Rs %.2f", data.PaymentTotal) }</strong><em>recorded amount</em></div>
							<div class="metric"><span>Subscription</span><strong>{ data.Organization.SubscriptionPlan }</strong><em>current account plan</em></div>
						</section>
						<section class="columns">
							<div class="section">
								<header>
									<h3>Machines</h3>
									<span class="subtle">number, type, status</span>
								</header>
								if len(data.RecentMachines) == 0 {
									<p class="empty">No machines found.</p>
								} else {
									<table>
										<thead><tr><th>Machine</th><th>Size</th><th>Type</th><th>Status</th></tr></thead>
										<tbody>
											for _, machine := range data.RecentMachines {
												<tr>
													<td>{ machine.MachineNumber }</td>
													<td>{ machine.Size }</td>
													<td>{ machine.Type }</td>
													<td>
														if machine.Status == "maintenance" {
															<span class="status warn">{ machine.Status }</span>
														} else {
															<span class="status">{ machine.Status }</span>
														}
													</td>
												</tr>
											}
										</tbody>
									</table>
								}
							</div>
							<div class="section">
								<header>
									<h3>Workers</h3>
									<span class="subtle">shift capacity</span>
								</header>
								if len(data.RecentWorkers) == 0 {
									<p class="empty">No workers found.</p>
								} else {
									<table>
										<thead><tr><th>Name</th><th>Avg Production</th><th>Closes</th><th>Shifts</th></tr></thead>
										<tbody>
											for _, worker := range data.RecentWorkers {
												<tr>
													<td>{ worker.Name }</td>
													<td>{ fmt.Sprintf("%.2f", worker.AverageProduction) }</td>
													<td>{ fmt.Sprint(worker.ClosePerShift) }</td>
													<td>{ fmt.Sprint(worker.NumberOfShifts) }</td>
												</tr>
											}
										</tbody>
									</table>
								}
							</div>
							<div class="section">
								<header>
									<h3>Stock</h3>
									<span class="subtle">quality and storage</span>
								</header>
								if len(data.RecentStockItems) == 0 {
									<p class="empty">No stock found.</p>
								} else {
									<table>
										<thead><tr><th>Item</th><th>Quality</th><th>Stored On</th><th>Qty</th></tr></thead>
										<tbody>
											for _, item := range data.RecentStockItems {
												<tr>
													<td>{ item.Name }</td>
													<td>{ item.Quality }</td>
													<td>{ item.StoredOn }</td>
													<td>{ fmt.Sprintf("%.2f %s", item.Quantity, item.Unit) }</td>
												</tr>
											}
										</tbody>
									</table>
								}
							</div>
							<div class="section">
								<header>
									<h3>Production</h3>
									<span class="subtle">recent entries</span>
								</header>
								if len(data.RecentProductions) == 0 {
									<p class="empty">No production found.</p>
								} else {
									<table>
										<thead><tr><th>Date</th><th>Shift</th><th>Qty</th></tr></thead>
										<tbody>
											for _, entry := range data.RecentProductions {
												<tr>
													<td>{ entry.EntryDate.Format("02 Jan 2006") }</td>
													<td>{ entry.Shift }</td>
													<td>{ fmt.Sprintf("%.2f %s", entry.Quantity, entry.Unit) }</td>
												</tr>
											}
										</tbody>
									</table>
								}
							</div>
						</section>
					}
				</main>
			</div>
		</body>
	</html>
}
