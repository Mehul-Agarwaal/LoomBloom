package views

import (
	"fmt"
	"loombloom/internal/store"
)

templ DashboardPage(data store.Dashboard) {
	@PageLayout("Dashboard", data.Organization, "dashboard") {
		if data.Organization.ID == "" {
			<section class="hero-panel" style="padding: 24px;">
				<h2>No business data yet</h2>
				<p style="margin-top: 12px; color: var(--muted); line-height: 1.6;">Run the development seed migration to populate machines, workers, stock, raw materials, payments, and production records.</p>
			</section>
		} else {
			<section class="hero">
				<div class="hero-panel" style="padding: 24px;">
					<h2 style="font-size: clamp(28px, 4vw, 48px); line-height: 1.02; max-width: 780px; letter-spacing: 0;">{ data.Organization.Name }</h2>
					<p style="margin-top: 12px; max-width: 720px; color: var(--muted); line-height: 1.6;">Track machines, workers, inventory, production, and payments from one practical workspace built for daily loom business management.</p>
				</div>
				<aside class="side-panel" style="padding: 18px; display: grid; align-content: space-between; gap: 18px;">
					<div>
						<p class="subtle">Owner</p>
						<strong style="display: block; font-size: 30px; font-family: 'Outfit', sans-serif; font-weight: 700; color: var(--neon-purple);">{ data.Organization.OwnerName }</strong>
					</div>
					<div>
						<p class="subtle">Phone</p>
						<strong style="display: block; font-size: 30px; font-family: 'Outfit', sans-serif; font-weight: 700; color: var(--neon-blue);">{ data.Organization.Phone }</strong>
					</div>
				</aside>
			</section>
			<section class="grid">
				<div class="metric"><span>Machines</span><strong>{ fmt.Sprint(data.MachineCount) }</strong><em>registered looms</em></div>
				<div class="metric"><span>Workers</span><strong>{ fmt.Sprint(data.WorkerCount) }</strong><em>active weaver records</em></div>
				<div class="metric"><span>Today Production</span><strong>{ fmt.Sprintf("%.2f m", data.TodayProduction) }</strong><em>current day output</em></div>
				<div class="metric"><span>Stock Quantity</span><strong>{ fmt.Sprintf("%.2f", data.StockQuantity) }</strong><em>finished stock stored</em></div>
				<div class="metric"><span>Raw Materials</span><strong>{ fmt.Sprint(data.RawMaterialCount) }</strong><em>material categories</em></div>
				<div class="metric"><span>Spare Parts</span><strong>{ fmt.Sprint(data.SparePartCount) }</strong><em>maintenance items</em></div>
				<div class="metric"><span>Payments</span><strong>{ fmt.Sprintf("Rs %.2f", data.PaymentTotal) }</strong><em>recorded amount</em></div>
				<div class="metric"><span>Subscription</span><strong>{ data.Organization.SubscriptionPlan }</strong><em>current account plan</em></div>
			</section>
			
			<style>
				.grid {
					display: grid;
					grid-template-columns: repeat(4, minmax(0, 1fr));
					gap: 16px;
					margin-bottom: 24px;
					margin-top: 24px;
				}
				.hero {
					display: grid;
					grid-template-columns: minmax(0, 1.7fr) minmax(260px, 0.8fr);
					gap: 24px;
					align-items: stretch;
					margin-bottom: 24px;
				}
				.metric {
					min-height: 120px;
					padding: 20px;
					border: 1px solid var(--line);
					border-radius: 12px;
					background: var(--panel);
					backdrop-filter: blur(16px);
					box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.25);
					transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
				}
				.metric:hover {
					border-color: rgba(0, 229, 255, 0.25);
					box-shadow: 0 8px 32px 0 rgba(0, 229, 255, 0.05), 0 0 15px rgba(192, 132, 252, 0.05);
					transform: translateY(-2px);
				}
				.metric span { color: var(--muted); font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }
				.metric strong { font-family: 'Outfit', sans-serif; display: block; margin-top: 10px; font-size: 28px; line-height: 1.1; font-weight: 700; color: var(--ink); }
				.metric em { display: block; margin-top: 8px; color: var(--neon-blue); font-size: 12px; font-style: normal; font-weight: 500; }
				.side-panel {
					background: var(--panel);
					border: 1px solid var(--line);
					border-radius: 12px;
					backdrop-filter: blur(16px);
					box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.25);
					transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
				}
				.side-panel:hover {
					border-color: rgba(192, 132, 252, 0.25);
					box-shadow: 0 8px 32px 0 rgba(192, 132, 252, 0.05), 0 0 15px rgba(0, 229, 255, 0.05);
					transform: translateY(-2px);
				}
				.columns {
					display: grid;
					grid-template-columns: repeat(2, minmax(0, 1fr));
					gap: 24px;
				}
				@media (max-width: 920px) {
					.hero, .columns { grid-template-columns: 1fr; }
					.grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
				}
				@media (max-width: 620px) {
					.grid { grid-template-columns: 1fr; }
				}
			</style>

			<section class="columns">
				<div class="section">
					<header>
						<h3>Machines</h3>
						<span class="subtle">recent looms</span>
					</header>
					if len(data.RecentMachines) == 0 {
						<p class="empty">No machines found.</p>
					} else {
						<table>
							<thead><tr><th>Machine</th><th>Size</th><th>Type</th><th>Status</th></tr></thead>
							<tbody>
								for _, machine := range data.RecentMachines {
									<tr>
										<td>{ machine.MachineNumber }</td>
										<td>{ machine.Size }</td>
										<td>{ machine.Type }</td>
										<td>
											if machine.Status == "maintenance" {
												<span class="status warn">{ machine.Status }</span>
											} else {
												<span class="status">{ machine.Status }</span>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					}
				</div>
				<div class="section">
					<header>
						<h3>Workers</h3>
						<span class="subtle">recent workers</span>
					</header>
					if len(data.RecentWorkers) == 0 {
						<p class="empty">No workers found.</p>
					} else {
						<table>
							<thead><tr><th>Name</th><th>Avg Production</th><th>Closes</th><th>Shifts</th></tr></thead>
							<tbody>
								for _, worker := range data.RecentWorkers {
									<tr>
										<td>{ worker.Name }</td>
										<td>{ fmt.Sprintf("%.2f", worker.AverageProduction) }</td>
										<td>{ fmt.Sprint(worker.ClosePerShift) }</td>
										<td>{ fmt.Sprint(worker.NumberOfShifts) }</td>
									</tr>
								}
							</tbody>
						</table>
					}
				</div>
				<div class="section">
					<header>
						<h3>Stock</h3>
						<span class="subtle">recent stock</span>
					</header>
					if len(data.RecentStockItems) == 0 {
						<p class="empty">No stock found.</p>
					} else {
						<table>
							<thead><tr><th>Item</th><th>Quality</th><th>Stored On</th><th>Qty</th></tr></thead>
							<tbody>
								for _, item := range data.RecentStockItems {
									<tr>
										<td>{ item.Name }</td>
										<td>{ item.Quality }</td>
										<td>{ item.StoredOn }</td>
										<td>{ fmt.Sprintf("%.2f %s", item.Quantity, item.Unit) }</td>
									</tr>
								}
							</tbody>
						</table>
					}
				</div>
				<div class="section">
					<header>
						<h3>Production</h3>
						<span class="subtle">recent entries</span>
					</header>
					if len(data.RecentProductions) == 0 {
						<p class="empty">No production found.</p>
					} else {
						<table>
							<thead><tr><th>Date</th><th>Shift</th><th>Qty</th></tr></thead>
							<tbody>
								for _, entry := range data.RecentProductions {
									<tr>
										<td>{ entry.EntryDate.Format("02 Jan 2006") }</td>
										<td>{ entry.Shift }</td>
										<td>{ fmt.Sprintf("%.2f %s", entry.Quantity, entry.Unit) }</td>
									</tr>
								}
							</tbody>
						</table>
					}
				</div>
			</section>
		}
	}
}
