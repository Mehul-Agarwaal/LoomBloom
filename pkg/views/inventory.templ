package views

import (
	"fmt"
	"loombloom/pkg/store"
)

templ InventoryPage(org store.Organization, stock []store.StockItem, errStr string) {
	@PageLayout("Inventory", org, "inventory") {
		<div class="page-header">
			<div class="page-title">
				<h2>Inventory & Stock</h2>
				<p>Manage raw materials (yarn) and finished goods (fabric).</p>
			</div>
			<div style="display: flex; gap: 12px;">
				<a href="/inventory/inward" class="btn btn-primary">Add Stock Inward</a>
				<a href="/inventory/outward" class="btn" style="border: 1px solid var(--line); color: var(--ink);">Log Dispatch</a>
			</div>
		</div>

		if errStr != "" {
			<div class="alert alert-danger">
				<strong>Error:</strong> { errStr }
			</div>
		}

		<div class="section">
			<header>
				<h3>Current Stock Levels</h3>
				<span class="subtle">{ fmt.Sprintf("%d items", len(stock)) }</span>
			</header>
			if len(stock) == 0 {
				<p class="empty">No inventory items tracked yet. Click "Add Stock Inward" to begin.</p>
			} else {
				<table>
					<thead>
						<tr>
							<th>Item Name</th>
							<th>Quality / Type</th>
							<th>Quantity</th>
							<th>Last Updated</th>
						</tr>
					</thead>
					<tbody>
						for _, s := range stock {
							<tr>
								<td style="font-weight: 600;">{ s.Name }</td>
								<td>{ s.Quality }</td>
								<td style="font-weight: 600; color: var(--accent);">{ fmt.Sprintf("%.2f %s", s.Quantity, s.Unit) }</td>
								<td>
									if s.StoredOn != "" {
										{ s.StoredOn }
									} else {
										<span class="subtle">N/A</span>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
		</div>
	}
}

templ InventoryInwardFormPage(org store.Organization, errStr string) {
	@PageLayout("Add Stock Inward", org, "inventory") {
		<div class="page-header">
			<div class="page-title">
				<h2>Add Stock Inward</h2>
				<p>Record new raw materials or returned goods.</p>
			</div>
			<a href="/inventory" class="btn" style="border: 1px solid var(--line); color: var(--ink);">Back to Inventory</a>
		</div>

		if errStr != "" {
			<div class="alert alert-danger">
				<strong>Error:</strong> { errStr }
			</div>
		}

		<div style="max-width: 600px; margin: 0 auto;">
			<div class="form-card" style="position: static;">
				<h3>Inward Details</h3>
				<form action="/inventory/inward" method="POST">
					<div class="form-group">
						<label for="name">Item Name *</label>
						<input type="text" id="name" name="name" class="form-control" placeholder="e.g. Cotton Yarn 40s" required />
					</div>
					<div class="form-group">
						<label for="quality">Quality / Type</label>
						<input type="text" id="quality" name="quality" class="form-control" placeholder="e.g. A-Grade" />
					</div>
					<div class="form-row">
						<div class="form-group">
							<label for="quantity">Quantity *</label>
							<input type="number" step="0.01" id="quantity" name="quantity" class="form-control" placeholder="0.00" required />
						</div>
						<div class="form-group">
							<label for="unit">Unit</label>
							<input type="text" id="unit" name="unit" class="form-control" value="kg" />
						</div>
					</div>
					<div class="form-group">
						<label for="stored_on">Storage Location / Date</label>
						<input type="text" id="stored_on" name="stored_on" class="form-control" placeholder="e.g. Godown 1" />
					</div>
					<button type="submit" class="btn btn-primary btn-block" style="margin-top: 16px;">Record Inward</button>
				</form>
			</div>
		</div>
	}
}
