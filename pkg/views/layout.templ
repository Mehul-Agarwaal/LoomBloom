package views

import (
	"loombloom/pkg/store"
)

templ PageLayout(title string, org store.Organization, activeTab string) {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } - LoomBloom</title>
			<style>
				@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap');

				:root {
					color-scheme: dark;
					--ink: #f8fafc;
					--muted: #94a3b8;
					--line: rgba(99, 102, 241, 0.12);
					--paper: #05070f;
					--panel: rgba(13, 17, 35, 0.65);
					--accent: #00e5ff; /* neon blue */
					--accent-2: #c084fc; /* purple */
					--ok: #00e676; /* neon green */
					--warn: #ffd600;
					--danger: #ff1744;
					
					--neon-blue: #00e5ff;
					--neon-purple: #c084fc;
					--deep-purple: #7c3aed;
				}
				* { box-sizing: border-box; }
				body {
					margin: 0;
					font-family: 'Plus Jakarta Sans', Inter, ui-sans-serif, system-ui, sans-serif;
					color: var(--ink);
					background: radial-gradient(circle at 50% 0%, #150d30 0%, #05070f 65%);
					background-attachment: fixed;
					min-height: 100vh;
				}
				.shell { min-height: 100vh; display: flex; flex-direction: column; }
				.topbar {
					display: flex;
					align-items: center;
					justify-content: space-between;
					gap: 24px;
					padding: 18px 28px;
					border-bottom: 1px solid var(--line);
					background: rgba(5, 7, 15, 0.85);
					backdrop-filter: blur(12px);
					position: sticky;
					top: 0;
					z-index: 100;
				}
				.topbar-left {
					display: flex;
					align-items: center;
					gap: 32px;
					flex: 1;
				}
				.brand { display: flex; align-items: center; gap: 12px; min-width: 0; text-decoration: none; color: inherit; }
				.brand h1 { font-family: 'Outfit', sans-serif; font-weight: 700; letter-spacing: -0.5px; }
				.mark {
					display: grid;
					place-items: center;
					width: 40px;
					height: 40px;
					border-radius: 10px;
					background: linear-gradient(135deg, var(--neon-blue), var(--deep-purple));
					color: #05070f;
					font-weight: 800;
					box-shadow: 0 0 20px rgba(0, 229, 255, 0.35);
					font-family: 'Outfit', sans-serif;
				}
				h1, h2, h3, p { margin: 0; }
				h1 { font-size: 19px; line-height: 1.2; }
				.subtle { color: var(--muted); font-size: 13px; margin-top: 3px; }
				.badge {
					display: inline-flex;
					align-items: center;
					height: 30px;
					padding: 0 12px;
					border: 1px solid rgba(192, 132, 252, 0.3);
					border-radius: 999px;
					background: rgba(192, 132, 252, 0.12);
					color: var(--neon-purple);
					font-size: 12px;
					font-weight: 600;
					white-space: nowrap;
					text-transform: uppercase;
					letter-spacing: 0.5px;
					box-shadow: 0 0 10px rgba(192, 132, 252, 0.08);
				}
				.nav-tabs {
					display: flex;
					gap: 6px;
				}
				.nav-tabs a {
					text-decoration: none;
					color: var(--muted);
					font-size: 14px;
					font-weight: 500;
					padding: 8px 14px;
					border-radius: 6px;
					transition: all 0.2s ease;
					border: 1px solid transparent;
				}
				.nav-tabs a:hover {
					color: var(--ink);
					background: rgba(255, 255, 255, 0.04);
				}
				.nav-tabs a.active {
					color: var(--neon-blue);
					background: rgba(0, 229, 255, 0.08);
					border: 1px solid rgba(0, 229, 255, 0.2);
					font-weight: 600;
					box-shadow: 0 0 15px rgba(0, 229, 255, 0.05);
				}
				main { padding: 28px; max-width: 1280px; width: 100%; margin: 0 auto; flex: 1; }
				
				/* Typography & General helper classes */
				.page-header {
					display: flex;
					align-items: center;
					justify-content: space-between;
					gap: 20px;
					margin-bottom: 24px;
				}
				.page-title h2 { font-family: 'Outfit', sans-serif; font-size: 30px; font-weight: 700; letter-spacing: -0.5px; }
				.page-title p { color: var(--muted); margin-top: 4px; }
				
				/* Forms */
				.form-card {
					background: var(--panel);
					border: 1px solid var(--line);
					border-radius: 12px;
					padding: 24px;
					position: sticky;
					top: 100px;
					backdrop-filter: blur(16px);
					box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.3);
					transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
				}
				.form-card:hover {
					border-color: rgba(0, 229, 255, 0.25);
					box-shadow: 0 8px 32px 0 rgba(0, 229, 255, 0.05), 0 0 15px rgba(192, 132, 252, 0.05);
					transform: translateY(-2px);
				}
				.form-card h3 {
					font-family: 'Outfit', sans-serif;
					font-size: 16px;
					font-weight: 600;
					margin-bottom: 16px;
					border-bottom: 1px solid var(--line);
					padding-bottom: 12px;
					color: var(--neon-purple);
					text-shadow: 0 0 10px rgba(192, 132, 252, 0.15);
				}
				.form-group {
					margin-bottom: 16px;
				}
				.form-group label {
					display: block;
					font-size: 13px;
					font-weight: 600;
					margin-bottom: 6px;
					color: var(--muted);
				}
				.form-control {
					width: 100%;
					height: 38px;
					padding: 8px 12px;
					border: 1px solid rgba(255, 255, 255, 0.08);
					border-radius: 8px;
					background: rgba(5, 7, 15, 0.7);
					color: var(--ink);
					font-family: inherit;
					font-size: 14px;
					transition: all 0.2s ease;
				}
				.form-control:focus {
					outline: none;
					border-color: var(--neon-blue);
					box-shadow: 0 0 10px rgba(0, 229, 255, 0.15);
					background: rgba(5, 7, 15, 0.9);
				}
				select.form-control option {
					background: #0d1122;
					color: var(--ink);
				}
				.form-row {
					display: grid;
					grid-template-columns: repeat(2, minmax(0, 1fr));
					gap: 12px;
				}
				.btn {
					display: inline-flex;
					align-items: center;
					justify-content: center;
					height: 40px;
					padding: 0 16px;
					border-radius: 8px;
					font-size: 14px;
					font-weight: 600;
					border: 1px solid transparent;
					cursor: pointer;
					transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
					font-family: inherit;
				}
				.btn-primary {
					background: linear-gradient(135deg, var(--neon-blue), var(--deep-purple));
					color: #05070f;
					box-shadow: 0 4px 15px rgba(0, 229, 255, 0.2);
				}
				.btn-primary:hover {
					transform: translateY(-1px);
					box-shadow: 0 6px 20px rgba(0, 229, 255, 0.35), 0 0 10px rgba(192, 132, 252, 0.25);
				}
				.btn-block {
					display: flex;
					width: 100%;
				}
				
				/* Grid & Layout */
				.two-col {
					display: grid;
					grid-template-columns: minmax(0, 2fr) minmax(320px, 1fr);
					gap: 24px;
				}
				.hero-panel, .section {
					background: var(--panel);
					border: 1px solid var(--line);
					border-radius: 12px;
					backdrop-filter: blur(16px);
					box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.3);
					transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
				}
				.hero-panel:hover, .section:hover {
					border-color: rgba(192, 132, 252, 0.25);
					box-shadow: 0 8px 32px 0 rgba(192, 132, 252, 0.05), 0 0 15px rgba(0, 229, 255, 0.05);
					transform: translateY(-2px);
				}
				.section { overflow: hidden; }
				.section header {
					display: flex;
					justify-content: space-between;
					align-items: center;
					gap: 16px;
					padding: 16px 18px;
					border-bottom: 1px solid var(--line);
					background: rgba(0, 0, 0, 0.15);
				}
				.section h3 { font-family: 'Outfit', sans-serif; font-size: 16px; font-weight: 600; color: var(--neon-purple); }
				
				/* Tables */
				table { width: 100%; border-collapse: collapse; table-layout: fixed; }
				th, td { padding: 13px 18px; text-align: left; border-bottom: 1px solid var(--line); font-size: 14px; vertical-align: middle; }
				th { color: var(--muted); font-weight: 600; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; background: rgba(0, 0, 0, 0.1); }
				td { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
				tr { transition: background-color 0.2s ease; }
				tr:hover td { background: rgba(255, 255, 255, 0.02); }
				tr:last-child td { border-bottom: 0; }
				
				.status {
					display: inline-flex;
					align-items: center;
					height: 24px;
					padding: 0 10px;
					border-radius: 999px;
					background: rgba(0, 230, 118, 0.12);
					color: var(--ok);
					border: 1px solid rgba(0, 230, 118, 0.2);
					font-size: 12px;
					text-transform: capitalize;
					font-weight: 600;
					box-shadow: 0 0 8px rgba(0, 230, 118, 0.08);
				}
				.status.warn {
					background: rgba(255, 214, 0, 0.12);
					color: var(--warn);
					border: 1px solid rgba(255, 214, 0, 0.2);
					box-shadow: 0 0 8px rgba(255, 214, 0, 0.08);
				}
				.empty { padding: 36px 18px; color: var(--muted); text-align: center; font-size: 14px; }
				
				/* Alerts */
				.alert {
					padding: 12px 16px;
					border-radius: 8px;
					margin-bottom: 16px;
					font-size: 14px;
				}
				.alert-danger {
					background: rgba(255, 23, 68, 0.12);
					border: 1px solid rgba(255, 23, 68, 0.2);
					color: var(--danger);
					box-shadow: 0 0 8px rgba(255, 23, 68, 0.08);
				}
				
				@media (max-width: 920px) {
					.two-col { grid-template-columns: 1fr; }
					.topbar-left { gap: 16px; }
				}
				@media (max-width: 768px) {
					.topbar { align-items: flex-start; flex-direction: column; padding: 16px; }
					.topbar-left { flex-direction: column; align-items: flex-start; width: 100%; }
					.nav-tabs { width: 100%; overflow-x: auto; padding-bottom: 4px; }
					main { padding: 16px; }
				}
			</style>
		</head>
		<body>
			<div class="shell">
				<header class="topbar">
					<div class="topbar-left">
						<a href="/" class="brand">
							<div class="mark">LB</div>
							<div>
								<h1>LoomBloom</h1>
								<p class="subtle">Loom owner operations dashboard</p>
							</div>
						</a>
						<nav class="nav-tabs">
							<a href="/" class={ templ.KV("active", activeTab == "dashboard") }>Dashboard</a>
							<a href="/production" class={ templ.KV("active", activeTab == "production") }>Production</a>
							<a href="/machines" class={ templ.KV("active", activeTab == "machines") }>Machines</a>
							<a href="/workers" class={ templ.KV("active", activeTab == "workers") }>Workers</a>
							<a href="/inventory" class={ templ.KV("active", activeTab == "inventory") }>Inventory</a>
							<a href="/settings" class={ templ.KV("active", activeTab == "settings") }>Settings</a>
						</nav>
					</div>
					if org.ID != "" {
						<div style="display: flex; align-items: center; gap: 16px;">
							<div class="badge">{ org.SubscriptionPlan } plan</div>
							<a href="/logout" style="text-decoration: none; color: var(--muted); font-size: 13px; font-weight: 600; padding: 6px 12px; border-radius: 6px; border: 1px solid var(--line); transition: all 0.2s;" onmouseover="this.style.color='var(--danger)'; this.style.borderColor='rgba(255, 23, 68, 0.3)'" onmouseout="this.style.color='var(--muted)'; this.style.borderColor='var(--line)'">Logout</a>
						</div>
					}
				</header>
				<main>
					{ children... }
				</main>
			</div>
		</body>
	</html>
}
